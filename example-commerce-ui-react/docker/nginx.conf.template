# Rendered by the nginx image at startup (envsubst). API_UPSTREAM selects the backend, e.g.
#   http://commerce-api-java:8080  or  http://commerce-api-next:3001
server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # pass W3C trace context through untouched for distributed tracing
        proxy_pass_request_headers on;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
